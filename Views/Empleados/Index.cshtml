
@model IEnumerable<CadenaSuministro.Models.Cotizacion>

@{
    ViewData["Title"] = "Cotizaciones";
}

<h1>Cotizaciones</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Crear nueva cotización</a>
</p>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Proveedor)</th>
            <th>@Html.DisplayNameFor(model => model.Producto)</th>
            <th>@Html.DisplayNameFor(model => model.Cantidad)</th>
            <th>@Html.DisplayNameFor(model => model.MontoEstimado)</th>
            <th>@Html.DisplayNameFor(model => model.Fecha)</th>
            <th>@Html.DisplayNameFor(model => model.Estado)</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@(item.Proveedor?.Nombre ?? "Sin proveedor")</td>
                <td>@(item.Producto?.Descripcion ?? "Sin producto")</td>
                <td>@item.Cantidad</td>
                <td>@item.MontoEstimado.ToString("C")</td>
                <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                <td>@item.Estado</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Editar</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Detalles</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
