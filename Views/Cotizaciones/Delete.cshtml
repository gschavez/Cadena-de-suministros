@model CadenaSuministro.Models.Cotizacion

@{
    ViewData["Title"] = "Eliminar Cotizaci├│n";
}

<h1>Eliminar Cotizaci├│n</h1>

<h3>┬┐Est├ís seguro de que quieres eliminar esto?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Proveedor</dt>
        <dd class="col-sm-10">@Model.Proveedor?.Nombre</dd>

        <dt class="col-sm-2">Producto</dt>
        <dd class="col-sm-10">@Model.Producto?.Descripcion</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Cantidad)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Cantidad)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.MontoEstimado)</dt>
        <dd class="col-sm-10">@Model.MontoEstimado.ToString("C")</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Fecha)</dt>
        <dd class="col-sm-10">@Model.Fecha.ToString("yyyy-MM-dd")</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Estado)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Estado)</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Eliminar" class="btn btn-danger" /> |
        <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
    </form>
</div>
