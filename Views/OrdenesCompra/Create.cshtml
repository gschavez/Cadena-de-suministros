
@model CadenaSuministro.Models.OrdenCompra

@{
    ViewData["Title"] = "Crear orden de compra";
}

<h1>Crear orden de compra</h1>

<p>Selecciona la cotización y el empleado responsable de la orden.</p>

<hr />

<div class="row">
    <div class="col-md-6">

        <form asp-action="Create" method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="form-group mb-3">
                <label asp-for="CotizacionId"
                       class="form-label">
                    Cotización
                </label>

                <select asp-for="CotizacionId"
                        class="form-select"
                        asp-items="ViewBag.CotizacionId">
                    <option value="">Seleccione una cotización</option>
                </select>

                <span asp-validation-for="CotizacionId"
                      class="text-danger">
                </span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="EmpleadoId"
                       class="form-label">
                    Empleado responsable
                </label>

                <select asp-for="EmpleadoId"
                        class="form-select"
                        asp-items="ViewBag.EmpleadoId">
                    <option value="">Seleccione un empleado</option>
                </select>

                <span asp-validation-for="EmpleadoId"
                      class="text-danger">
                </span>
            </div>

            <div class="alert alert-info">
                La orden se registrará inicialmente con estado
                <strong>Pendiente</strong>.
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">
                    Crear orden
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Volver
                </a>
            </div>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
